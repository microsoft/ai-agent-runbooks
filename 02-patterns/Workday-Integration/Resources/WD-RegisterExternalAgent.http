### Request OAuth2 Token
@gateway = {REGION}.agent.workday.com
@tenant = 
@clientId = 
@clientSecret = 

@code = 

POST https://{{gateway}}/auth/oauth2/{{tenant}}/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{code}}&client_id={{clientId}}&client_secret={{clientSecret}}


### Register External Agent
@token = 

POST https://{{gateway}}/asor/v1/agentDefinition
Authorization: Bearer {{token}}
Content-Type: application/json
accept-encoding: identity
wd-agent-tenant-alias: {{tenant}}

