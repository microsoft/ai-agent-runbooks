### Request OAuth2 Token
@gateway = {REGION}.agent.workday.com
@tenant =
@clientId =
@clientSecret =

@code =

POST https://{{gateway}}/auth/oauth2/{{tenant}}/token
Content-Type: application/x-www-form-urlencoded

grant_type=authorization_code&code={{code}}&client_id={{clientId}}&client_secret={{clientSecret}}


### Register External Agent
@token =

POST https://{{gateway}}/asor/v1/agentDefinition
Authorization: Bearer {{token}}
Content-Type: application/json
accept-encoding: identity
wd-agent-tenant-alias: {{tenant}}

{
  "name": "Copilot Studio",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "stateTransitionHistory": false,
    "pushNotifications": false
  },
  "platform": {
    "id": "Platform=MICROSOFT_COPILOT_STUDIO"
  },
  "description": "Copilot Studio integration ",
  "url": "https://copilotstudio.microsoft.com",
  "provider": {
    "id": "Provider=Self-Built"
  },
  "skills": [
    {
      "id": "read_home_phone",
      "name": "Read home phone numbers",
      "description": "Read the signed-in worker's current home phone numbers.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "update_home_phone",
      "name": "Update an existing home phone number",
      "description": "Read current home phones, open a home contact change, update an existing phone on that event, and submit the event after explicit user confirmation. Check event status and verify the resulting home phone.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "read_employee_profile",
      "name": "Read employee profile",
      "description": "Retrieve the signed-in worker's profile to report their worker ID, display name, business title, public primary work email, and work location when returned and authorized. Do not infer missing fields or treat the location name as a full postal address.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "read_hire_and_service_dates",
      "name": "Read hire and service dates",
      "description": "Resolve the signed-in worker's Workday ID and retrieve their hire and service dates when authorized. Distinguish the current hire date from the original hire date.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "read_home_address",
      "name": "Read home addresses",
      "description": "Read the signed-in worker's current home addresses. This capability does not read a work address or change any address.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "read_absence_balances",
      "name": "Read vacation and absence balances",
      "description": "Resolve the signed-in worker's Workday ID and retrieve remaining absence balances for the requested date. Identify the relevant vacation plan and report its balance, unit, and effective date without combining unrelated plans or assuming hours are days.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    },
    {
      "id": "request_time_off",
      "name": "Request time off",
      "description": "Resolve the signed-in worker, check eligible time-off types, valid dates, daily quantities, balances, and existing entries, then create a time-off request only after explicit user confirmation. Creating the request starts the Workday approval workflow; do not report approval unless Workday confirms it. Do not invent IDs, quantities, units, reasons, or missing required values.",
      "inputModes": [
        {
          "type": "text/plain"
        }
      ],
      "outputModes": [
        {
          "type": "text/plain"
        },
        {
          "type": "application/json"
        }
      ]
    }
  ],
  "workdayConfig": [
    {
      "skillId": "read_home_phone",
      "executionMode": {
        "id": "Mode=Delegate"
      },
      "workdayResources": [
